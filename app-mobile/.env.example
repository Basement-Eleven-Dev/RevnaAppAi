# Configurazione Firebase (Console Firebase > Impostazioni progetto > App web).
# Copia questo file in .env.local e compila i valori. .env.local non va committato.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Emulator Suite locale: metti 1 per usare gli emulatori invece del progetto reale.
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=0
# Su emulatore Android usa 10.0.2.2; su device fisico l'IP della macchina.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=localhost
