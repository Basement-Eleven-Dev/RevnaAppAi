rules_version = '2';

// Regole di partenza: tutto chiuso per default.
// Le collezioni vere vanno aggiunte una alla volta, quando il modello dati è deciso.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isRevnaAdmin() {
      return isSignedIn() && request.auth.token.revnaAdmin == true;
    }

    // Profilo del cliente, redatto da Revna dal backoffice.
    //
    // Il cliente lo legge e può integrarlo con note proprie, ma non riscrivere
    // quello che ha steso il consulente: l'update dal client è ammesso solo se
    // tocca `profile.noteCliente` e nient'altro.
    //
    // Il backoffice legge; per scrivere passa dalle Cloud Functions
    // (`createInvite`, `saveClientProfile`), che normalizzano i campi.
    match /users/{userId} {
      allow read: if isSelf(userId) || isRevnaAdmin();

      allow update: if isSelf(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['profile', 'updatedAt'])
        && request.resource.data.profile.diff(resource.data.profile).affectedKeys()
             .hasOnly(['noteCliente']);

      allow create, delete: if false;

      // Schede dei documenti condivisi da Revna. Il file vero sta su Storage,
      // qui c'è solo la sua descrizione. Le scrive il backoffice, che carica
      // anche il file: passare da una function costringerebbe a far transitare
      // il binario dal server senza guadagnarci nulla.
      match /documents/{documentId} {
        allow read: if isSelf(userId) || isRevnaAdmin();
        allow create, update, delete: if isRevnaAdmin();
      }

      // Comunicazioni di Revna consegnate a questo cliente: la sua copia dell'avviso,
      // con il proprio `lettoAt`. L'originale sta in `announcements`, che il cliente
      // non vede: lì ci sono anche i destinatari, cioè chi altro è cliente Revna.
      //
      // Nessuno scrive da qui. La consegna la fanno `sendAnnouncement` e
      // `saveAnnouncement` con l'Admin SDK; `lettoAt` lo scrive
      // `markAnnouncementRead`, che conta la lettura anche sull'originale — un
      // documento che il cliente non potrebbe toccare.
      match /announcements/{announcementId} {
        allow read: if isSelf(userId) || isRevnaAdmin();
        allow create, update, delete: if false;
      }

      // Token per le notifiche push, uno per dispositivo.
      //
      // È l'unica sottocollezione che il cliente scrive da sé, e non c'era altro modo:
      // il token lo rilascia il servizio push al dispositivo, e nessun altro lo conosce.
      // Non è un dato riservato in senso stretto — serve solo a recapitare una notifica
      // a quel telefono — ma resta chiuso a tutti gli altri, referenti Revna compresi:
      // l'elenco dei dispositivi di un cliente non serve a nessuno dal backoffice.
      // Chi manda le notifiche li legge con l'Admin SDK (vedi `push.ts`).
      match /pushTokens/{tokenId} {
        allow read, write: if isSelf(userId);
      }

      // Conversazioni con l'assistente.
      //
      // Le rilegge anche il backoffice, nella rotta «Conversazioni» del cliente:
      // un consulente che sta per parlare con la struttura deve poter vedere cosa
      // ha già chiesto all'assistente. Cancellarle resta del solo cliente — la
      // chat è sua, e Revna non deve poterne far sparire dei pezzi.
      //
      // Le scrive esclusivamente `askAssistant`, che è anche l'unico posto in cui
      // lo storico viene composto — così il client non può riscrivere il passato.
      match /conversations/{conversationId} {
        allow read: if isSelf(userId) || isRevnaAdmin();
        allow delete: if isSelf(userId);
        allow create, update: if false;
      }

      // Memoria dell'assistente: le preferenze di questo cliente su come vuole essere assistito.
      //
      // È l'unico posto in cui il cliente scrive su qualcosa che ha scritto il modello,
      // e le regole dicono esattamente quanto: può **correggere il testo** di una riga
      // e può **cancellarla**, non può aggiungerne né riscriverne la data o la
      // provenienza. Annotare è dell'assistente, che è la parte onesta della promessa:
      // quello che si legge lì è ciò che l'assistente ha capito, non ciò che il cliente
      // vorrebbe che avesse capito.
      //
      // La cancellazione in blocco passa da `clearMemory`: un'operazione su un numero
      // di documenti che il client non conosce, e un diritto che merita un punto solo
      // in cui succede.
      //
      // I 280 caratteri sono il `MAX_ENTRY_CHARS` di `memory.ts`, ripetuto qui perché le
      // regole non possono importarlo: se cambia là, cambia anche qui.
      //
      // Le legge anche il backoffice, come le conversazioni e per lo stesso motivo: un
      // consulente che sta per parlare con la struttura deve poter vedere come il suo
      // referente vuole essere trattato. Non le scrive: la memoria è fra cliente e agente.
      match /memory/{entryId} {
        allow read: if isSelf(userId) || isRevnaAdmin();

        allow update: if isSelf(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['testo', 'updatedAt', 'origine'])
          && request.resource.data.testo is string
          && request.resource.data.testo.size() > 0
          && request.resource.data.testo.size() <= 280
          && request.resource.data.origine == 'cliente';

        allow delete: if isSelf(userId);
        allow create: if false;
      }
    }

    // Richieste di contatto: quando l'assistente non basta, il cliente chiede una persona.
    //
    // Collezione di primo livello e non sottocollezione dell'utente perché il
    // backoffice le guarda tutte insieme, come una coda (vedi `requests.ts`). Il
    // cliente vede le sue: la condizione su `uid` obbliga la sua query a filtrare
    // per il proprio, altrimenti Firestore la rifiuta in blocco.
    //
    // Nessuno le scrive da qui. Aprirle e cambiarne lo stato passa da
    // `createContactRequest` e `updateContactRequest`: il recapito del cliente e lo
    // stato sono le due cose che nessuna delle due parti deve poter riscrivere da sé —
    // il cliente non si dà per «chiusa» una richiesta, e non si dichiara un numero
    // di telefono diverso da quello del suo profilo.
    match /contactRequests/{requestId} {
      allow read: if isRevnaAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // Comunicazioni di Revna ai clienti: gli originali, con destinatari e letture.
    //
    // Chiusa ai clienti anche in lettura: contiene l'elenco di chi riceve, cioè chi
    // altro è cliente Revna e quanti sono. Il cliente vede la sua copia, in
    // `users/{uid}/announcements` (vedi `backend/functions/src/announcements.ts`).
    //
    // Il backoffice legge; per scrivere passa dalle functions. Non è una cautela
    // contro i referenti Revna: `stato` e `destinatariCount` sono il resoconto di una
    // consegna, e se li potesse scrivere il client «inviato a 42 clienti» sarebbe
    // un'affermazione senza garanzie.
    match /announcements/{announcementId} {
      allow read: if isRevnaAdmin();
      allow create, update, delete: if false;
    }

    // Personalità dell'assistente, redatta dal backoffice.
    //
    // Il documento è diviso in due per un motivo di riservatezza: `config` contiene
    // il system prompt, cioè come Revna ha istruito l'agente, e non deve uscire dal
    // backoffice; `public` contiene solo quello che l'app deve poter mostrare da sé,
    // oggi gli spunti della nuova conversazione. Li scrive lo stesso form.
    match /agent/config {
      allow read, write: if isRevnaAdmin();
    }

    match /agent/public {
      allow read: if isSignedIn();
      allow write: if isRevnaAdmin();
    }

    // Base di conoscenza Revna: metodo, playbook, checklist, KPI.
    //
    // Chiusa ai clienti anche in lettura: è il patrimonio di Revna, e il cliente ne
    // deve vedere solo quello che l'assistente cita in risposta a una domanda.
    // `askAssistant` la legge con l'Admin SDK, che non passa da queste regole.
    match /knowledge/{entryId} {
      allow read, write: if isRevnaAdmin();
    }

    // Tutto il resto è negato finché non viene aperto esplicitamente.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
